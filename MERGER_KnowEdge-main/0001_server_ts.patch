 const __dirname = path.dirname(__filename);
 
+// --- Forensic Run Controller ---
+class RunController {
+  private runs: Record<string, any> = {};
+  private heartbeats: Record<string, any> = {};
+
+  async createRun(objective: string, artifacts: any) {
+    const runId = `run_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`;
+    this.runs[runId] = {
+      id: runId,
+      objective,
+      artifacts,
+      state: 'created',
+      timestamp: new Date().toISOString()
+    };
+    
+    this.updateHeartbeat(runId, 'created', 0);
+    this.executeRun(runId);
+    return this.runs[runId];
+  }
+
+  private updateHeartbeat(runId: string, phase: string, progress: number) {
+    this.heartbeats[runId] = {
+      runId,
+      phase,
+      progress,
+      status: 'healthy',
+      updatedAt: new Date().toISOString()
+    };
+  }
+
+  private async executeRun(runId: string) {
+    const phases = [
+      { name: 'validating', weight: 10 },
+      { name: 'ingesting', weight: 20 },
+      { name: 'indexing', weight: 20 },
+      { name: 'mapping', weight: 15 },
+      { name: 'comparing', weight: 15 },
+      { name: 'qa', weight: 10 },
+      { name: 'completed', weight: 10 }
+    ];
+
+    let currentProgress = 0;
+    for (const phase of phases) {
+      this.runs[runId].state = phase.name;
+      currentProgress += phase.weight;
+      this.updateHeartbeat(runId, phase.name, currentProgress);
+      await new Promise(r => setTimeout(r, 800)); // Forensic processing simulation
+    }
+  }
+
+  getRun(runId: string) { return this.runs[runId]; }
+  getHeartbeat(runId: string) { return this.heartbeats[runId]; }
+}
+
+const controller = new RunController();
+
