# KnowEdge Merger V3.1 - Environment Variables

# --- Core Secrets ---
GEMINI_API_KEY=
ADMIN_ACCESS_CODE=

# --- Database (SQLite Local) ---
APP_DB=sqlite:///data/app.db

# --- Cache & Queues (In-Memory) ---
CACHE_BACKEND=memory

# --- Object Storage (Filesystem) ---
STORAGE_BACKEND=filesystem
STORAGE_PATH=./data/objects

# --- AI Screening (Local) ---
AI_SCREENING_MODE=local
AI_SCREENING_MODEL=binoculars-local-v2.1
AI_SCREENING_THRESHOLD_WARN=0.45
AI_SCREENING_THRESHOLD_REVIEW=0.75

# --- Grammar & Style (Local LanguageTool) ---
LANGUAGETOOL_URL=http://languagetool:8081/v2
VALE_MODE=local

# --- Similarity & Vector Search (Local Qdrant) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333

# --- Social Automation ---
SOCIAL_MODE=off

# --- Review Workflow ---
MAX_UPLOAD_MB=25
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/png,image/jpeg

# --- Versioning ---
VERSION=3.1
NODE_NAME=DEVELOPMENT_NODE_01
