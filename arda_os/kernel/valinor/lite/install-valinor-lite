#!/usr/bin/env python3

import argparse
import sys
from pathlib import Path

from kernel.valinor.lite.installer.rollback import (
    rollback_valinor_lite,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="install-valinor-lite",
        description="Valinor Lite installer control surface.",
    )

    modes = parser.add_mutually_exclusive_group()

    modes.add_argument(
        "--preflight",
        action="store_true",
        help="inspect installation readiness without mutation",
    )
    modes.add_argument(
        "--install",
        action="store_true",
        help="perform installation transaction",
    )
    modes.add_argument(
        "--dry-run",
        action="store_true",
        help="simulate installation without mutation",
    )
    modes.add_argument(
        "--rollback",
        action="store_true",
        help="rollback using recorded installer state",
    )
    modes.add_argument(
        "--verify",
        action="store_true",
        help="verify installed Valinor Lite state",
    )

    parser.add_argument(
        "--target-root",
        type=Path,
    )
    parser.add_argument(
        "--backup-root",
        type=Path,
    )
    parser.add_argument(
        "--state-path",
        type=Path,
    )

    return parser


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if not any(
        (
            args.preflight,
            args.install,
            args.dry_run,
            args.rollback,
            args.verify,
        )
    ):
        parser.print_help()
        return 0

    if args.preflight:
        print("PREFLIGHT")
        return 0

    if args.dry_run:
        print("DRY_RUN")
        return 0

    if args.install:
        print("INSTALL")
        return 0

    if args.verify:
        print("VERIFY")
        return 0

    if args.rollback:
        if not all(
            (
                args.target_root,
                args.backup_root,
                args.state_path,
            )
        ):
            print(
                "rollback requires --target-root, "
                "--backup-root, and --state-path",
                file=sys.stderr,
            )
            return 2

        result = rollback_valinor_lite(
            target_root=args.target_root,
            backup_root=args.backup_root,
            state_path=args.state_path,
        )

        if not result.success:
            print("ROLLBACK_REFUSED", file=sys.stderr)
            return 1

        print(
            "ROLLBACK_COMPLETE "
            f"backup_id={result.restored_backup_id}"
        )
        return 0

    return 1


if __name__ == "__main__":
    sys.exit(main())
