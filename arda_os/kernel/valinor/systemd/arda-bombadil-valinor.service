[Unit]
Description=ARDA Bombadil witness for Valinor boot
Documentation=file:/home/byron/Integritas-Mechanicus/arda_os/kernel/valinor/README.md
After=network.target tpm2-abrmd.service arda-valinor-postboot.service
Wants=tpm2-abrmd.service arda-valinor-postboot.service
ConditionKernelCommandLine=!arda.recovery=1

[Service]
Type=simple
WorkingDirectory=/home/byron/Integritas-Mechanicus
ExecStart=/usr/bin/python3 /home/byron/Integritas-Mechanicus/arda_os/backend/services/arda_bombadil.py
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
User=root
Group=root
Environment=ARDA_ROOT=/home/byron/Integritas-Mechanicus
Environment=ARDA_SOVEREIGN_MODE=1
Environment=ARDA_ENFORCEMENT_MODE=audit
Environment=ARDA_SOCK=/run/arda/bombadil.sock
Environment=ARDA_PID=/run/arda/bombadil.pid
RuntimeDirectory=arda
RuntimeDirectoryMode=0755
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/arda /var/lib/arda /home/byron/Integritas-Mechanicus/evidence
PrivateTmp=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
