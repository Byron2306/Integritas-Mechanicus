[Unit]
Description=ARDA Valinor Ring-0 BPF LSM Authority
Documentation=file:/usr/lib/arda/src/arda_os/kernel/valinor/README.md
DefaultDependencies=no
After=local-fs.target sys-fs-bpf.mount
Wants=sys-fs-bpf.mount
Before=arda-ring0-verify.service
Before=arda-valinor-postboot.service
Before=arda-phase4-remote-verifier.service
ConditionKernelCommandLine=!arda.recovery=1

[Service]
Type=simple
Environment=PYTHONPATH=/usr/lib/arda/src/arda_os
RuntimeDirectory=arda
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/rm -f /run/arda/ring0-ready /run/arda/ring0-restore.json
ExecStartPre=/usr/bin/mkdir -p /sys/fs/bpf/arda
ExecStart=/usr/lib/arda/src/arda_os/backend/services/bpf/arda_lsm_loader /usr/lib/arda/src/arda_os/backend/services/bpf/arda_physical_lsm.o --pin-root /sys/fs/bpf/arda --enforcement-mode scoped_strict --defer-attach-until /run/arda/ring0-ready
ExecStartPost=/usr/bin/python3 /usr/lib/arda/src/arda_os/kernel/valinor/scripts/restore_ring0_boot_state.py --ready-file /run/arda/ring0-ready --receipt /run/arda/ring0-restore.json
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
User=root
Group=root

[Install]
WantedBy=multi-user.target
