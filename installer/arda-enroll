        break

checks["bootstrap_control_group"] = bool(control_group)

cgroup_kernel_id = None

if control_group:
    cgroup_path = Path("/sys/fs/cgroup") / control_group.lstrip("/")

    try:
        cgroup_kernel_id = cgroup_path.stat().st_ino
    except OSError:
        cgroup_kernel_id = None

checks["bootstrap_cgroup_kernel_id"] = (
