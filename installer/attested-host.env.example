# ARDA attested-host verifier configuration.
#
# The verifier private key MUST NOT live on this host.

ARDA_VERIFIER_URL=https://VERIFIER_HOST/verify/phase4
ARDA_VERIFIER_PUBLIC_KEY=/etc/arda/verifier/verifier-key.pub.pem
ARDA_VERIFIER_KEY_ID=arda-phase4-verifier

ARDA_POSTBOOT_USE_LOOPBACK_VERIFIER=0
ARDA_POSTBOOT_REQUIRE_VERIFIER=1
ARDA_POSTBOOT_PROMOTE_STRICT=0
ARDA_SOVEREIGN_MODE=1
